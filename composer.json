{
    "name": "swapfix/swapfix",
    "description": "SwapFix PHP application starter for gadget sales, exchanges and repairs.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.10",
        "phpmailer/phpmailer": "^7.0",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": { "SwapFix\\": "app/" }
    },
    "scripts": {
        "dev": "@php -S 127.0.0.1:8000 -t public public/router.php",
        "test": "phpunit",
        "lint": "@php scripts/lint.php",
        "check": "@php scripts/check.php",
        "check:supabase": "@php scripts/check.php --supabase"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": { "php": "8.4.0" }
    }
}
