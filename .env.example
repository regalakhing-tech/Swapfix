# Copy to .env for local development. Set these in Vercel for hosted execution.
APP_NAME=SwapFix
APP_ENV=local
# Exact site origin. HTTPS here turns on Secure, __Host- cookies and HSTS.
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
# Encrypts session cookies and signs CSRF tokens. Generate one per environment:
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Supabase Dashboard > Connect / API Keys. Use a publishable key here, never a secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
UPLOAD_MAX_BYTES=4194304

# PHPMailer application email. Supabase Auth email has its own SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SwapFix

# Optional notification email worker (/internal/mail/dispatch). Server-side only.
# Leave empty to keep notifications in-app only.
SUPABASE_SECRET_KEY=
CRON_SECRET=
