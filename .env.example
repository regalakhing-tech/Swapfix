# Copy to .env for local development. Set these in Vercel for hosted execution.
APP_NAME=SwapFix
APP_ENV=local
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

# Supabase Dashboard > Connect / API Keys. Use a publishable key, never a secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
UPLOAD_MAX_BYTES=5242880

# PHPMailer application email. Supabase Auth email has its own SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SwapFix
